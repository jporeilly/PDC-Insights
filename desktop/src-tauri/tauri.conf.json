{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PDC Catalog Insights",
  "version": "1.16.0",
  "identifier": "com.pentaho.pdc-insights",
  "build": {
    "beforeBuildCommand": "npm run fetch:python && npm run stage:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDC Catalog Insights",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/python": "python",
      "vendor/app": "app",
      "../scripts/lib/common.ps1": "provisioning/lib/common.ps1",
      "../scripts/install-ollama.ps1": "provisioning/install-ollama.ps1",
      "../scripts/check-environment.ps1": "provisioning/check-environment.ps1"
    },
    "category": "Business",
    "shortDescription": "AI-assisted dashboards for Pentaho Data Catalog",
    "longDescription": "Reads governance metrics from the Pentaho Data Catalog REST API (trust, quality, sensitivity/PII, glossary coverage, profiling health, lineage), renders them as navigable dashboards, and builds new dashboards from a plain-language prompt using a local or commercial LLM.",
    "publisher": "Pentaho Presales Engineering",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign.ps1 %1"
    }
  },
  "plugins": {}
}
