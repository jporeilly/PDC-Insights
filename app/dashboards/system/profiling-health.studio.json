{
  "version": 1,
  "title": "Profiling health",
  "category": "system",
  "subtitle": "Scan & profile status",
  "panels": [
    {
      "id": "k1",
      "kind": "kpi",
      "title": "Profiled assets",
      "query": "profile_status",
      "span": 1
    },
    {
      "id": "k2",
      "kind": "kpi",
      "title": "Failed scans",
      "query": "profile_status",
      "span": 1
    },
    {
      "id": "k3",
      "kind": "kpi",
      "title": "Avg scan time",
      "query": "scan_activity",
      "span": 1
    },
    {
      "id": "k4",
      "kind": "kpi",
      "title": "Workers active",
      "query": "worker_status",
      "span": 1
    },
    {
      "id": "c1",
      "kind": "chart",
      "title": "Profiling status",
      "query": "profile_status",
      "chartType": "donut",
      "bindings": {
        "category": "status",
        "value": "count"
      },
      "span": 2
    },
    {
      "id": "c2",
      "kind": "chart",
      "title": "Assets by data source",
      "query": "assets_by_source",
      "chartType": "bar",
      "bindings": {
        "category": "source",
        "value": "count"
      },
      "span": 2
    },
    {
      "id": "c3",
      "kind": "chart",
      "title": "Scan & profile activity",
      "query": "scan_activity",
      "chartType": "calendarHeatmap",
      "bindings": {
        "x": "date",
        "value": "count"
      },
      "span": 4
    },
    {
      "id": "t1",
      "kind": "table",
      "title": "Stale & failed assets",
      "query": "stale_failed",
      "span": 4
    }
  ]
}