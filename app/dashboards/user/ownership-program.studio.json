{
  "version": 1,
  "title": "Ownership program",
  "category": "user",
  "subtitle": "Who owns what \u2014 and what nobody owns",
  "panels": [
    {
      "id": "k1",
      "kind": "kpi",
      "title": "Assets owned",
      "query": "owners_coverage",
      "span": 1
    },
    {
      "id": "k2",
      "kind": "kpi",
      "title": "Data sources",
      "query": "source_counts",
      "span": 1
    },
    {
      "id": "k3",
      "kind": "kpi",
      "title": "High sensitivity",
      "query": "sensitivity_mix",
      "span": 1
    },
    {
      "id": "k4",
      "kind": "kpi",
      "title": "Catalog assets",
      "query": "asset_counts",
      "span": 1
    },
    {
      "id": "c1",
      "kind": "chart",
      "title": "Owned vs unowned by source",
      "query": "owners_coverage",
      "chartType": "stackedBar",
      "bindings": {
        "category": "source",
        "value": "count",
        "series": "status"
      },
      "span": 2
    },
    {
      "id": "c2",
      "kind": "chart",
      "title": "Owner workload",
      "query": "owner_workload",
      "chartType": "bar",
      "bindings": {
        "category": "owner",
        "value": "count"
      },
      "span": 2
    },
    {
      "id": "c3",
      "kind": "chart",
      "title": "Edits by action",
      "query": "edit_activity",
      "chartType": "donut",
      "bindings": {
        "category": "action",
        "value": "count"
      },
      "span": 2
    },
    {
      "id": "t1",
      "kind": "table",
      "title": "Unowned high-value assets",
      "query": "unowned_high_value",
      "span": 2
    }
  ]
}